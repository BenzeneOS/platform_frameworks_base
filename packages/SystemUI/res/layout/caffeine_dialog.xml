<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Duration island: slider + value -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/caffeine_duration_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.Material3.DayNight"
        android:checkable="true"
        android:checked="false"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?android:attr/colorControlHighlight"
        app:checkedIcon="@null">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <com.google.android.material.slider.Slider
                android:id="@+id/caffeine_slider"
                style="@style/SystemUI.Material3.Slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="-8dp"
                android:theme="@style/Theme.Material3.DayNight"
                android:valueFrom="1"
                android:valueTo="120"
                android:value="120"
                android:stepSize="1"
                app:labelBehavior="floating" />

            <TextView
                android:id="@+id/caffeine_duration_label"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="∞"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Until unplugged island -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/caffeine_unplugged_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:theme="@style/Theme.Material3.DayNight"
        android:checkable="true"
        android:checked="false"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?android:attr/colorControlHighlight"
        app:checkedIcon="@null"
        app:rippleColor="?android:attr/colorControlHighlight">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:gravity="center"
            android:text="@string/quick_settings_caffeine_duration_until_unplugged"
            android:textSize="14sp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Off island -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/caffeine_off_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:theme="@style/Theme.Material3.DayNight"
        android:checkable="true"
        android:checked="false"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?android:attr/colorControlHighlight"
        app:checkedIcon="@null"
        app:rippleColor="?android:attr/colorControlHighlight">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:gravity="center"
            android:text="@string/quick_settings_caffeine_off"
            android:textSize="14sp" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
